{
  "$description": "Tier 1 · core primitives · ONE family across every brand (decided 2026-10-27). The family itself is not chosen yet: system stack is a PLACEHOLDER until the type study picks a Google Fonts sans.",
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$description": "PLACEHOLDER. Replace with the chosen Google Fonts sans (one family, all brands).",
        "$extensions": {
          "org.aid.library": {
            "placeholder": true
          }
        }
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ],
        "$description": "PLACEHOLDER mono for code, coordinates and telemetry readouts.",
        "$extensions": {
          "org.aid.library": {
            "placeholder": true
          }
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "size": {
      "100": {
        "$type": "dimension",
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "200": {
        "$type": "dimension",
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "300": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "400": {
        "$type": "dimension",
        "$value": {
          "value": 18,
          "unit": "px"
        }
      },
      "500": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "600": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        }
      },
      "700": {
        "$type": "dimension",
        "$value": {
          "value": 30,
          "unit": "px"
        }
      },
      "800": {
        "$type": "dimension",
        "$value": {
          "value": 38,
          "unit": "px"
        }
      },
      "900": {
        "$type": "dimension",
        "$value": {
          "value": 48,
          "unit": "px"
        }
      },
      "1000": {
        "$type": "dimension",
        "$value": {
          "value": 60,
          "unit": "px"
        }
      },
      "$type": "dimension",
      "$extensions": {
        "org.aid.library": {
          "placeholder": true
        }
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.15
      },
      "snug": {
        "$value": 1.3
      },
      "normal": {
        "$value": 1.5
      }
    }
  }
}
