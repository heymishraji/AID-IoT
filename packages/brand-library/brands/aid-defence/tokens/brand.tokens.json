{
  "$description": "Brand roles. The ONLY place this brand's identity enters the system: semantic tokens reference brand.*, never palette.*. A rebrand edits this file and palette.tokens.json; nothing else changes.",
  "brand": {
    "color": {
      "primary": {
        "base": {
          "$value": "{palette.placeholder-deep-blue.700}",
          "$description": "Primary brand colour on light surfaces (actions, links)."
        },
        "hover": {
          "$value": "{palette.placeholder-deep-blue.800}"
        },
        "subtle": {
          "$value": "{palette.placeholder-deep-blue.100}",
          "$description": "Tinted brand surface."
        },
        "on": {
          "$value": "{color.neutral.0}",
          "$description": "Text/icon on primary.base."
        }
      },
      "primary-dark": {
        "base": {
          "$value": "{palette.placeholder-deep-blue.300}",
          "$description": "Primary brand colour on dark surfaces."
        },
        "hover": {
          "$value": "{palette.placeholder-deep-blue.100}"
        },
        "subtle": {
          "$value": "{palette.placeholder-deep-blue.900}"
        },
        "on": {
          "$value": "{color.neutral.1000}"
        }
      },
      "accent": {
        "base": {
          "$value": "{palette.placeholder-sand.700}",
          "$description": "Secondary brand colour: highlights and illustration, used sparingly."
        },
        "on": {
          "$value": "{color.neutral.0}"
        },
        "dark": {
          "$value": "{palette.placeholder-sand.300}"
        },
        "on-dark": {
          "$value": "{color.neutral.1000}"
        }
      },
      "data-viz": {
        "1": {
          "$value": "{palette.placeholder-deep-blue.500}"
        },
        "2": {
          "$value": "{palette.placeholder-sand.500}"
        },
        "3": {
          "$value": "{palette.placeholder-deep-blue.300}"
        },
        "4": {
          "$value": "{palette.placeholder-sand.300}"
        },
        "5": {
          "$value": "{palette.placeholder-deep-blue.700}"
        },
        "6": {
          "$value": "{palette.placeholder-sand.700}"
        }
      }
    },
    "font": {
      "accent": {
        "$type": "fontFamily",
        "$value": "{font.family.sans}",
        "$description": "Optional per-brand accent face (display only). Defaults to the shared family."
      }
    }
  }
}
