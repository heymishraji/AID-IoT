{
  "$description": "Tier 2 · semantic · type roles. Components and templates use these, never font.size.* directly. display uses the brand accent face (defaults to the shared family).",
  "type": {
    "display": {
      "family": {
        "$value": "{brand.font.accent}"
      },
      "size": {
        "$value": "{font.size.900}"
      },
      "line-height": {
        "$value": "{font.line-height.tight}"
      },
      "weight": {
        "$value": "{font.weight.semibold}"
      }
    },
    "heading-1": {
      "family": {
        "$value": "{font.family.sans}"
      },
      "size": {
        "$value": "{font.size.800}"
      },
      "line-height": {
        "$value": "{font.line-height.tight}"
      },
      "weight": {
        "$value": "{font.weight.semibold}"
      }
    },
    "heading-2": {
      "family": {
        "$value": "{font.family.sans}"
      },
      "size": {
        "$value": "{font.size.700}"
      },
      "line-height": {
        "$value": "{font.line-height.snug}"
      },
      "weight": {
        "$value": "{font.weight.semibold}"
      }
    },
    "heading-3": {
